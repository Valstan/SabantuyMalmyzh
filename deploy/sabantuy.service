# Сабантуй Малмыж — systemd-юнит прод-сервера (Next standalone).
# Артефакт собирается в CI и распаковывается в releases/<sha>; current → симлинк.
# Установка на сервере — подставив реальные значения вместо <плейсхолдеров>
# (точные значения: D-038, они живут в комнате КАРМАНа и в воркфлоу деплоя, не здесь):
#   sudo cp deploy/sabantuy.service /etc/systemd/system/sabantuy.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now sabantuy
[Unit]
Description=Sabantuy Malmyzh (Next.js standalone)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=<пользователь-сервиса>
WorkingDirectory=<корень-развёртывания>/current
# Секреты (DATABASE_URL, PAYLOAD_SECRET, PORT, HOSTNAME, …) — вне репо (pool #008).
EnvironmentFile=<путь-к-env-файлу-сервиса>
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
# Ограничиваем рантайм, чтобы не уронить postgres на том же боксе.
MemoryMax=1024M
# Лёгкая защита
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
